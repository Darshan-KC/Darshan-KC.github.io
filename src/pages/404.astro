---
import BaseLayout from "@layouts/BaseLayout.astro";
import profile from "@data/profile.json";
---

<BaseLayout
  title={`Not Found · ${profile.name}`}
  description="Page not found — the page you're looking for doesn't exist."
  noindex
>
  <section
    class="flex flex-1 items-center justify-center bg-paper-50 py-20"
    data-reveal
  >
    <div class="mx-auto max-w-xl px-4 text-center sm:px-6 lg:px-8">
      <div class="relative">
        <p
          class="text-[10rem] font-bold leading-none tracking-tight text-ink-950 sm:text-[12rem]"
        >
          404
        </p>
        <div
          class="via-paper-50/60 pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent to-paper-50"
        >
        </div>
      </div>
      <div class="-mt-10 space-y-6">
        <h1
          class="text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl"
        >
          Page not found
        </h1>
        <p class="mx-auto max-w-md text-base leading-7 text-ink-500">
          The page you are looking for does not exist, has been moved, or is
          temporarily unavailable.
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-[12px] bg-ink-950 px-8 py-4 text-base font-semibold text-button-fg shadow-card transition hover:bg-ink-800"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mr-3"
            ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
            ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
          >
          Back to homepage
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
