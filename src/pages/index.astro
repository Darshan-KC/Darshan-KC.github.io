---
import BaseLayout from "@layouts/BaseLayout.astro";
import profile from "@data/profile.json";
import { siteConfig } from "@lib/site";
import { personSchema, webSiteSchema } from "@lib/schema";
import HeroSection from "@sections/hero/HeroSection.astro";
import AboutSection from "@sections/about/AboutSection.astro";
import ProjectsSection from "@sections/projects/ProjectsSection.astro";
import ExperienceSection from "@sections/experience/ExperienceSection.astro";
import SkillsSection from "@sections/skills/SkillsSection.astro";
import CommunitySection from "@sections/community/CommunitySection.astro";
import ArticlesSection from "@sections/articles/ArticlesSection.astro";
import GithubSection from "@sections/github/GithubSection.astro";
import ContactSection from "@sections/contact/ContactSection.astro";
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  canonicalPath="/"
  image={profile.picture}
  imageAlt={siteConfig.ogImageAlt}
  imageWidth={siteConfig.ogImageWidth}
  imageHeight={siteConfig.ogImageHeight}
  type="website"
  schema={[webSiteSchema(), personSchema()]}
>
  <HeroSection />
  <ProjectsSection featuredOnly />
  <AboutSection />
  <ExperienceSection />
  <SkillsSection />
  <CommunitySection />
  <ArticlesSection />
  <GithubSection />
  <ContactSection />
</BaseLayout>
