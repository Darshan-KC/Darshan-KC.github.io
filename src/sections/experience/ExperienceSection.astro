---
import SectionWrapper from "@sections/shared/SectionWrapper.astro";
import ExperienceTimeline from "@sections/experience/ExperienceTimeline.astro";
import experience from "@data/experience.json";

const sortedExperience = [...experience].sort((a, b) => b.id - a.id);
const professional = sortedExperience.filter(
  (item) => item.type === "Professional",
);
const community = sortedExperience.filter((item) => item.type === "Community");
---

<SectionWrapper
  id="experience"
  eyebrow="Experience"
  title="A timeline of professional growth, mentorship, and technical leadership."
  description="My experience has moved from hands-on delivery to broader influence through architecture thinking, mentorship, and community work."
>
  <div class="space-y-16">
    <div>
      <div class="mb-8 flex items-center gap-4">
        <h3 class="text-2xl font-semibold tracking-tight text-ink-950">
          Professional
        </h3>
        <span class="h-px flex-1 bg-paper-200"></span>
      </div>
      <ExperienceTimeline items={professional} />
    </div>
    <div>
      <div class="mb-8 flex items-center gap-4">
        <h3 class="text-2xl font-semibold tracking-tight text-ink-950">
          Community
        </h3>
        <span class="h-px flex-1 bg-paper-200"></span>
      </div>
      <ExperienceTimeline items={community} />
    </div>
  </div>
</SectionWrapper>
