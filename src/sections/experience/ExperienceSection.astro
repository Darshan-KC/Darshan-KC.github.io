---
import SectionWrapper from "@sections/shared/SectionWrapper.astro";
import experience from "@data/experience.json";
---

<SectionWrapper
  id="experience"
  eyebrow="Experience"
  title="A timeline of professional growth, mentorship, and technical leadership."
  description="My experience has moved from hands-on delivery to broader influence through architecture thinking, mentorship, and community work."
>
  <div class="relative">
    <div class="absolute left-[1.375rem] top-0 h-full w-px bg-paper-200 lg:left-1/2 lg:-translate-x-px" />

    {experience.map((item, index) => (
      <div class="group relative mb-10 pl-14 last:mb-0 lg:mb-12 lg:w-1/2 lg:pl-0 lg:odd:ml-0 lg:odd:pr-16 lg:even:ml-auto lg:even:pl-16" data-reveal data-reveal-delay={`${index * 100}`}>
        <div class="absolute left-[0.875rem] top-7 z-10 flex h-4 w-4 items-center justify-center rounded-full border-2 border-accent-600 bg-surface lg:left-auto lg:right-[-0.5rem] lg:odd:right-[-0.5rem] lg:even:left-[-0.5rem] lg:even:right-auto">
          <span class="h-2 w-2 rounded-full bg-accent-600" />
        </div>

        <div class="rounded-[20px] border border-paper-200 bg-surface p-8 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-accent-700">{item.type}</span>
            <p class="text-sm text-ink-500">{item.period}</p>
          </div>
          <div class="mt-4">
            <h3 class="text-xl font-semibold text-ink-950">{item.title}</h3>
            <p class="mt-1 text-base font-medium text-accent-500">{item.organization}</p>
          </div>
          <p class="mt-4 text-base leading-7 text-ink-500">{item.summary}</p>
          <p class="mt-3 text-sm text-ink-500">{item.location}</p>
        </div>
      </div>
    ))}
  </div>
</SectionWrapper>
