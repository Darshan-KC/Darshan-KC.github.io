---
import SectionWrapper from "@sections/shared/SectionWrapper.astro";
import projects from "@data/projects.json";

interface Props {
  featuredOnly?: boolean;
  headingLevel?: "h1" | "h2";
}

const { featuredOnly = false, headingLevel = "h2" } = Astro.props;

const sortedProjects = [...projects].sort((a, b) => b.id - a.id);
const displayProjects = featuredOnly
  ? sortedProjects.filter((project) => project.featured)
  : sortedProjects;
---

<SectionWrapper
  id="projects"
  eyebrow="Projects"
  title="Engineering case studies built around architecture and reliability."
  description="These engagements demonstrate practical backend problem-solving with clear outcomes and maintainable implementation choices."
  headingLevel={headingLevel}
>
  <div class="grid gap-8 lg:grid-cols-2">
    {
      displayProjects.map((project, index) => (
        <article
          class="group relative flex flex-col rounded-[20px] border border-paper-200 bg-surface shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg"
          data-reveal
          data-reveal-delay={`${index * 100}`}
        >
          <div class="flex items-center justify-between gap-4 border-b border-paper-200 px-10 pb-5 pt-10">
            <span class="rounded-full bg-accent-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent-700">
              {project.type}
            </span>
            {project.github && (
              <a
                href={project.github}
                class="text-sm font-medium text-ink-500 transition hover:text-accent-500"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="inline-block"
                >
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
              </a>
            )}
          </div>

          <div class="flex flex-1 flex-col px-10 py-6">
            <h3 class="text-2xl font-semibold tracking-tight text-ink-950">
              {project.title}
            </h3>
            <p class="mt-3 text-base leading-7 text-ink-500">
              {project.summary}
            </p>

            <div class="mt-6 space-y-4">
              <div class="border-accent-200 border-l-2 pl-4">
                <p class="text-sm font-semibold text-ink-800">Problem</p>
                <p class="mt-1 text-sm leading-6 text-ink-500">
                  {project.problem}
                </p>
              </div>
              <div class="border-ink-200 border-l-2 pl-4">
                <p class="text-sm font-semibold text-ink-800">Solution</p>
                <p class="mt-1 text-sm leading-6 text-ink-500">
                  {project.solution}
                </p>
              </div>
            </div>
          </div>

          <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-paper-200 px-10 py-5">
            {project.stack.map((item) => (
              <span class="rounded-full bg-paper-50 px-3 py-1.5 text-xs font-medium text-ink-600">
                {item}
              </span>
            ))}
            <div class="ml-auto">
              <a
                href={`/case-studies/${project.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-500 transition hover:text-accent-600"
              >
                Read case study
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {
    featuredOnly && (
      <div class="mt-8 text-center">
        <a
          href="/case-studies"
          class="hover:border-accent-300 inline-flex items-center rounded-[12px] border border-paper-200 bg-surface px-6 py-3 text-sm font-semibold text-ink-950 transition hover:text-accent-600"
        >
          View all case studies &rarr;
        </a>
      </div>
    )
  }
</SectionWrapper>
