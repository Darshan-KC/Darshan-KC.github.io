---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<section id={id} class="scroll-mt-24 bg-paper-50 py-20" data-reveal>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-accent-500">{eyebrow}</p>
      <h2 class="text-4xl font-semibold tracking-tight text-ink-950 sm:text-5xl">{title}</h2>
      {description &&       <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-500">{description}</p>}
    </div>
    <div class="mt-14">
      <slot />
    </div>
  </div>
</section>
