---
import SectionWrapper from "@sections/shared/SectionWrapper.astro";
import certifications from "@data/certifications.json";
---

<SectionWrapper
  id="certifications"
  eyebrow="Certifications"
  title="Evidence of continued growth and professional depth."
  description="I value practical learning as much as formal credentials, and I continue building depth in both engineering and leadership."
>
  <div class="grid gap-8 md:grid-cols-2">
    {certifications.map((item, index) => (
      <div class="rounded-[20px] border border-paper-200 bg-surface p-10 shadow-card transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg" data-reveal data-reveal-delay={`${index * 100}`}>
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-accent-500">{item.year}</p>
        <h3 class="mt-3 text-xl font-semibold text-ink-950">{item.title}</h3>
        <p class="mt-2 text-base text-ink-500">{item.issuer}</p>
      </div>
    ))}
  </div>
</SectionWrapper>
