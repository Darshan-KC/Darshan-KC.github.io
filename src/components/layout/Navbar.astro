---
import navigation from "@data/navigation.json";
import profile from "@data/profile.json";
import ThemeToggle from "@components/ui/ThemeToggle";
import Icon from "@components/ui/Icon.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  const target = href.replace(/\/+$/, "");
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header
  class="sticky top-0 z-20 mx-auto mb-6 w-full max-w-7xl rounded-[12px] border border-paper-200 bg-surface/80 px-5 py-4 shadow-sm backdrop-blur-xl backdrop-saturate-150 sm:rounded-[20px] sm:px-8"
>
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.3em] text-accent-500"
    >
      <picture class="dark:hidden">
        <source srcset="/images/logo-white-bg.webp" type="image/webp" />
        <img src="/images/logo-white-bg.png" alt="Logo" class="h-8 scale-[2]" />
      </picture>
      <picture class="hidden dark:block">
        <source srcset="/images/logo-dark-bg.webp" type="image/webp" />
        <img src="/images/logo-dark-bg.png" alt="Logo" class="h-8 scale-[2]" />
      </picture>
      <span class="sr-only">{profile.name}</span>
    </a>
    <div class="flex items-center gap-3">
      <nav
      aria-label="Primary navigation"
      class="hidden items-center gap-6 text-sm text-ink-600 sm:flex"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`transition hover:text-ink-950 ${
              isActive(item.href) ? "font-semibold text-ink-950" : ""
            }`}
          >
            <Icon name={item.icon} class="mr-2 inline-block" />
            {item.label}
          </a>
        ))
      }
    </nav>

      <button
        type="button"
        aria-label="Search (Ctrl+K)"
        title="Search (Ctrl+K)"
        onclick="window.dispatchEvent(new CustomEvent('open-command-palette'))"
        class="flex h-9 shrink-0 items-center gap-2 rounded-[12px] border border-paper-200 bg-paper-50 px-3 text-sm text-ink-500 transition hover:text-ink-950"
      >
        <svg
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden rounded-md border border-paper-200 bg-surface px-2 py-0.5 text-xs text-ink-500 sm:inline-block">⌘K</kbd>
      </button>

      <ThemeToggle client:idle />

      <details
      class="group relative sm:hidden [&[open]_.nav-toggle-open]:hidden [&[open]_.nav-toggle-close]:block"
    >
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-[12px] border border-paper-200 text-ink-700 transition hover:text-ink-950 [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
      >
        <svg
          class="nav-toggle-open h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          class="nav-toggle-close hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="6"></line>
        </svg>
      </summary>

      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 top-full z-30 mt-3 flex w-56 flex-col gap-1 rounded-[1.5rem] border border-paper-200 bg-surface p-2 text-sm text-ink-600 shadow-card"
      >
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class={`rounded-2xl px-4 py-3 transition hover:bg-paper-50 hover:text-ink-950 ${
                isActive(item.href)
                  ? "bg-paper-50 font-semibold text-ink-950"
                  : ""
              }`}
            >
              <Icon name={item.icon} class="mr-3 inline-block shrink-0" size={16} />
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
    </div>
  </div>
</header>
